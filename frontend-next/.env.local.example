# URL del backend FastAPI (solo server-side; el navegador nunca la ve)
BACKEND_URL=http://localhost:8000

# API key compartida con el backend (misma que CXR_API_KEY del backend).
# Vacia en desarrollo local = backend sin validacion de key.
BACKEND_API_KEY=

# NextAuth — generar con: openssl rand -base64 32
AUTH_SECRET=cambia-esto-por-una-clave-secreta-larga-y-aleatoria

# URL publica de la app. En `npm run dev` se detecta sola; OBLIGATORIA cuando
# corre el server standalone (Docker/Cloud Run) o los redirects de auth
# apuntan a 0.0.0.0:3000.
# AUTH_URL=http://localhost:3000

# Contraseña inicial del admin sembrado en SQLite (default: hnal2026)
# SEED_ADMIN_PASSWORD=
